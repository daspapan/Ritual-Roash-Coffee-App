{
  "compilerOptions": {
    "target": "ES2020", 
    "module": "CommonJS", 
    "strict": true, 
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true, 
    "forceConsistentCasingInFileNames": true, 
    "outDir": "./dist", 
    "rootDir": "./"
  },
  "include": ["./*.ts"], "exclude": ["node_modules"]
}